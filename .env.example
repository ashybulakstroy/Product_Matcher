# Project settings
APP_NAME=matching_product
LOG_LEVEL=INFO
OCR_WEB_HOST=0.0.0.0
OCR_WEB_PORT=8017
# CPU threads for OCR; inter-operation ONNX threads are fixed at 1.
OCR_ONNX_THREADS=2
OCR_OPENCV_THREADS=2
# off | shadow | select (select is the default when unset)
OCR_GRID_CURVATURE_V2=select

# Data paths
INPUT_DIR=data/input
REFERENCE_DIR=data/reference
OUTPUT_DIR=data/output
